PORT=3001
DATABASE_URL=postgresql://app:app@localhost:5432/app?schema=public

# Obrigatoria: a API se recusa a subir sem ela.
# Em producao o Render injeta o valor (render.yaml declara sync: false).
# Para gerar uma: openssl rand -hex 32
JWT_SECRET=

# Usadas apenas pelo seed do primeiro admin (pnpm --filter api prisma:seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=
